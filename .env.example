# PostgreSQL (pgvector extension 설치 필요)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sknmsauto

# DGX LLM (OpenAI-compatible vLLM)
DGX_URL=http://<DGX_IP>:8000
DGX_API_KEY=dummy
DGX_MODEL=Qwen2.5-14B
DGX_EMBED_MODEL=Qwen2.5-14B

# Claude fallback (선택)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# 임베딩 제공자 — 런타임 중 전환 금지 (차원 불일치 방지)
# dgx: DGX /v1/embeddings 사용
# local: sentence-transformers all-MiniLM-L6-v2 (384-dim, 오프라인)
EMBED_BACKEND=local

# 임베딩 차원 (EMBED_BACKEND에 맞게 설정)
# local → 384  /  dgx → DGX 모델 출력 차원 확인 후 설정
EMBED_DIM=384
